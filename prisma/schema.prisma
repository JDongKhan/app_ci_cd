generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  account      String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         String
  level        String?
  team         String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  devRequirements Requirement[]         @relation("RequirementDevOwner")
  qaRequirements  Requirement[]         @relation("RequirementQaOwner")
  pmRequirements  Requirement[]         @relation("RequirementPmOwner")
  qaMemberOf      RequirementQaMember[]
  tasks           Task[]                @relation("TaskOwner")

  @@map("users")
}

model RolePermission {
  role          String
  level         String
  permissionKey String @map("permission_key")

  @@id([role, level, permissionKey])
  @@map("role_permissions")
}

model App {
  id              String   @id @default(uuid())
  name            String
  platform        String
  code            String
  repo            String
  defaultBranch   String   @default("main") @map("default_branch")
  buildScript     String   @default("./build_app") @map("build_script")
  artifactType    String   @map("artifact_type")
  artifactPattern String?  @map("artifact_pattern")
  channels        String?
  isComponent     Boolean  @default(false) @map("is_component")
  branchesJson    String   @map("branches_json")
  machine         String   @default("builder-01")
  stack           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([name, platform])
  @@map("apps")

  pipelines       Pipeline[]
  components      AppComponent[] @relation("HostAppComponents")
  usedAsComponent AppComponent[] @relation("ComponentApps")
}

model AppComponent {
  id             String   @id @default(uuid())
  appId          String   @map("app_id")
  componentAppId String   @map("component_app_id")
  version        String?
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  app          App @relation("HostAppComponents", fields: [appId], references: [id], onDelete: Cascade)
  componentApp App @relation("ComponentApps", fields: [componentAppId], references: [id], onDelete: Cascade)

  @@unique([appId, componentAppId])
  @@index([componentAppId])
  @@map("app_components")
}

model Requirement {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String?
  devOwnerId  String   @map("dev_owner_id")
  qaOwnerId   String   @map("qa_owner_id")
  pmOwnerId   String   @map("pm_owner_id")
  priority    String   @default("P1")
  startAt     DateTime @map("start_at")
  dueAt       DateTime @map("due_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  devOwner  User                  @relation("RequirementDevOwner", fields: [devOwnerId], references: [id])
  qaOwner   User                  @relation("RequirementQaOwner", fields: [qaOwnerId], references: [id])
  pmOwner   User                  @relation("RequirementPmOwner", fields: [pmOwnerId], references: [id])
  qaMembers RequirementQaMember[]
  tasks     Task[]

  @@map("requirements")
}

model RequirementQaMember {
  requirementId String @map("requirement_id")
  userId        String @map("user_id")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@id([requirementId, userId])
  @@map("requirement_qa_members")
}

model Task {
  id          String    @id @default(uuid())
  reqId       String    @map("req_id")
  title       String
  description String?
  ownerId     String    @map("owner_id")
  priority    String    @default("P1")
  startAt     DateTime  @map("start_at")
  dueAt       DateTime  @map("due_at")
  status      String    @default("none")
  statusAt    DateTime? @map("status_at")
  statusBy    String?   @map("status_by")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  requirement Requirement @relation(fields: [reqId], references: [id])
  owner       User        @relation("TaskOwner", fields: [ownerId], references: [id])
  pipelines   Pipeline[]

  @@index([reqId])
  @@index([ownerId])
  @@index([status])
  @@map("tasks")
}

model Pipeline {
  id           String    @id @default(uuid())
  taskId       String    @map("task_id")
  appId        String    @map("app_id")
  name         String
  branch       String
  status       String    @default("none")
  reworkFrom   String?   @map("rework_from")
  reworkReason String?   @map("rework_reason")
  reworkBy     String?   @map("rework_by")
  reworkAt     DateTime? @map("rework_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  task      Task               @relation(fields: [taskId], references: [id])
  app       App                @relation(fields: [appId], references: [id])
  merges    PipelineMerge[]
  conflicts PipelineConflict[]
  events    PipelineEvent[]
  builds    Build[]

  @@unique([taskId, appId, branch])
  @@index([taskId])
  @@map("pipelines")
}

model PipelineMerge {
  id                String    @id @default(uuid())
  pipelineId        String    @map("pipeline_id")
  stage             String
  fromBranch        String    @map("from_branch")
  toBranch          String    @map("to_branch")
  sha               String
  commits           Int       @default(0)
  operatorId        String?   @map("operator_id")
  mergedAt          DateTime  @default(now()) @map("merged_at")
  invalidatedAt     DateTime? @map("invalidated_at")
  invalidatedReason String?   @map("invalidated_reason")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
  @@map("pipeline_merges")
}

model PipelineConflict {
  id          String    @id @default(uuid())
  pipelineId  String    @map("pipeline_id")
  stage       String
  tempBranch  String    @map("temp_branch")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by")

  pipeline Pipeline               @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  files    PipelineConflictFile[]

  @@index([pipelineId])
  @@map("pipeline_conflicts")
}

model PipelineConflictFile {
  id         String @id @default(uuid())
  conflictId String @map("conflict_id")
  path       String

  conflict PipelineConflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)

  @@map("pipeline_conflict_files")
}

model PipelineEvent {
  id         String   @id @default(uuid())
  pipelineId String   @map("pipeline_id")
  type       String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  payloadJson String? @map("payload_json")
  actorId    String?  @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
  @@map("pipeline_events")
}

model Build {
  id           String    @id @default(uuid())
  pipelineId   String    @map("pipeline_id")
  stage        String
  buildNumber  Int       @default(0) @map("build_number")
  versionName  String?   @map("version_name")
  versionCode  Int?      @map("version_code")
  channel      String?
  mergeSha     String?   @map("merge_sha")
  status       String    @default("running")
  progress     Int       @default(0)
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  durationMs   Int?      @map("duration_ms")
  exitCode     Int?      @map("exit_code")
  failReason   String?   @map("fail_reason")
  logPath      String?   @map("log_path")
  logSizeBytes Int       @default(0) @map("log_size_bytes")
  logTail      String?   @map("log_tail")
  logTruncated Boolean   @default(false) @map("log_truncated")
  logDeletedAt DateTime? @map("log_deleted_at")
  triggeredBy  String?   @map("triggered_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  artifacts Artifact[]

  @@index([pipelineId])
  @@map("builds")
}

model Artifact {
  id               String    @id @default(uuid())
  buildId          String    @map("build_id")
  originalName     String    @map("original_name")
  displayName      String    @map("display_name")
  type             String
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  sha256           String
  relativePath     String    @map("relative_path")
  status           String    @default("available")
  downloadCount    Int       @default(0) @map("download_count")
  lastDownloadedAt DateTime? @map("last_downloaded_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([buildId, relativePath])
  @@index([status, createdAt])
  @@map("artifacts")
}
